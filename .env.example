# Copied to .env for local dev — src/server.js loads it with dotenv.
PORT=10000
# Optional. Leave empty to derive URLs from the request host. Set for a custom domain.
PUBLIC_URL=
RECEIVE_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_ID=
DATA_DIR=./data
NODE_ENV=development
# Optional persistent mood history on serverless (Vercel): Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: force a store backend (redis | sqlite | memory)
MOOD_STORE=
